#!/usr/bin/env sh

# Starts every process in Procfile.dev: the Rails server and the Vite dev
# server. Foreman is installed on demand rather than added to the Gemfile,
# because running it inside Bundler leaks the parent bundle context into the
# processes it spawns.

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

exec foreman start -f Procfile.dev "$@"
